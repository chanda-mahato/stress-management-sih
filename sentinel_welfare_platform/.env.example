# ==============================================================================
# SENTINEL WELFARE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local environment: cp .env.example .env
# 2. Generate cryptographically strong secrets using Python:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. NEVER commit the active '.env' file to source control.
# ==============================================================================

# Operational Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Application Database Connection String
# Development default: sqlite:///./sentinel.db
# Production (PostgreSQL): postgresql://sentinel_admin:<POSTGRES_PASSWORD>@postgres:5432/sentinel_welfare
DATABASE_URL=sqlite:///./sentinel.db

# JWT Cryptographic Signing Key (HS256)
# Mandatory in production (startup fails if unset or set to changeme_*)
JWT_SECRET=changeme_generate_a_real_secret_with_secrets_token_hex_32

# Coturn WebRTC Traversal Secret (§6a Security Directive)
# Mandatory in production (startup fails if unset or set to changeme_*)
TURN_SECRET=changeme_generate_a_real_turn_secret_with_secrets_token_hex_32
TURN_HOST=localhost
TURN_PORT=3478

# PostgreSQL Production Credentials (used by docker-compose)
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=changeme_postgres_secure_password
POSTGRES_DB=sentinel_welfare

# Ephemeral Cache / Chatbot Rate-Limiter (Redis)
REDIS_URL=redis://redis:6379/0

# Live SMS Gateway Carrier Credentials (Optional - Leave blank for Local Mock Console Mode)
# Fast2SMS (Indian Mobile Numbers): Get key from https://www.fast2sms.com/
FAST2SMS_API_KEY=changeme_fast2sms_api_key

# Twilio (International / US Carrier):
TWILIO_ACCOUNT_SID=changeme_twilio_account_sid
TWILIO_AUTH_TOKEN=changeme_twilio_auth_token
TWILIO_PHONE_NUMBER=changeme_twilio_phone_number

